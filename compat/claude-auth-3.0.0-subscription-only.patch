diff --git a/src/vendor-hardening.test.ts b/src/vendor-hardening.test.ts
new file mode 100644
index 0000000..e9ac497
--- /dev/null
+++ b/src/vendor-hardening.test.ts
@@ -0,0 +1,67 @@
+import assert from "node:assert/strict"
+import { readFile } from "node:fs/promises"
+import { describe, it } from "node:test"
+import { finishClaudeResponse } from "./provider.ts"
+
+const credentialsSource = new URL("./credentials.ts", import.meta.url)
+
+describe("subscription-only hardening", () => {
+  it("does not spawn Claude CLI inference or borrow another account", async () => {
+    const source = await readFile(credentialsSource, "utf8")
+    assert.doesNotMatch(source, /from ["']node:child_process["']/)
+    assert.doesNotMatch(source, /execSync|claude -p|--model haiku/)
+    assert.match(
+      source,
+      /function tryFallbackAccount\(excludeSource: string\): ClaudeCredentials \| null \{[\s\S]*?return null\n\}/,
+    )
+    assert.doesNotMatch(
+      source.match(
+        /function tryFallbackAccount\(excludeSource: string\): ClaudeCredentials \| null \{([\s\S]*?)\n\}/,
+      )?.[1] ?? "",
+      /allAccounts|refreshAccount\(/,
+    )
+  })
+
+  it("returns denied responses without retrying", async () => {
+    const request = new Request("https://api.anthropic.com/v1/messages", {
+      method: "POST",
+      headers: { authorization: "Bearer selected-token" },
+      body: JSON.stringify({ model: "claude-sonnet-4-6", messages: [] }),
+    })
+    for (const status of [400, 401, 429]) {
+      let calls = 0
+      const initial = new Response("denied", { status })
+      const result = await finishClaudeResponse(
+        request,
+        initial,
+        undefined,
+        async () => {
+          calls++
+          return new Response("unexpected retry")
+        },
+      )
+      assert.equal(calls, 0, `status ${status} must not retry`)
+      assert.equal(result, initial, `status ${status} must return initial response`)
+    }
+  })
+
+  it("sends rate-limit responses exactly once", async () => {
+    for (const status of [429, 529]) {
+      let calls = 0
+      const transport = async () => {
+        calls++
+        return new Response("rate limited", { status })
+      }
+      const request = new Request("https://api.anthropic.com/v1/messages", {
+        method: "POST",
+        body: JSON.stringify({ model: "claude-sonnet-4-6", messages: [] }),
+      })
+      const result = await (await import("./provider.ts")).claudeSubscriptionFetch(
+        "selected-token",
+        transport,
+      )(request)
+      assert.equal(calls, 1, `status ${status} must send exactly once`)
+      assert.equal(result.status, status)
+    }
+  })
+})

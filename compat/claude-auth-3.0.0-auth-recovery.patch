diff --git a/src/harness-telemetry.ts b/src/harness-telemetry.ts
new file mode 100644
index 0000000..18691ea
--- /dev/null
+++ b/src/harness-telemetry.ts
@@ -0,0 +1,32 @@
+// Harness r32: append-only telemetry for the opencode-usage-harness token-saving
+// report (<HARNESS_STATE_DIR>/telemetry/token-saving.jsonl). Callers pass only
+// closed-set fields; this module never writes a token or header value and never throws.
+import { appendFileSync, mkdirSync, renameSync, statSync } from "node:fs"
+import { homedir } from "node:os"
+import { dirname, join } from "node:path"
+
+const MAX_BYTES = 8 * 1024 * 1024
+const SECRET_KEY = /token|authorization|secret|key|bearer|refresh|access/i
+
+export function harnessTelemetryFile(env: NodeJS.ProcessEnv = process.env): string {
+  const state = env.HARNESS_STATE_DIR || join(homedir(), ".local/state/opencode-usage-harness")
+  return join(state, "telemetry", "token-saving.jsonl")
+}
+
+export function recordHarnessAuthEvent(record: Record<string, unknown>, file = harnessTelemetryFile()): void {
+  try {
+    const safe: Record<string, unknown> = {}
+    for (const [key, value] of Object.entries(record)) {
+      if (SECRET_KEY.test(key)) continue
+      if (typeof value === "string") safe[key] = value.slice(0, 120)
+      else if (typeof value === "number" || typeof value === "boolean") safe[key] = value
+    }
+    mkdirSync(dirname(file), { recursive: true, mode: 0o700 })
+    let size = 0
+    try { size = statSync(file).size } catch {}
+    if (size >= MAX_BYTES) renameSync(file, `${file}.1`)
+    appendFileSync(file, JSON.stringify({ version: 1, at: new Date().toISOString(), ...safe }) + "\n", { mode: 0o600 })
+  } catch {
+    // telemetry is optional
+  }
+}
diff --git a/src/harness-auth-recovery.test.ts b/src/harness-auth-recovery.test.ts
new file mode 100644
index 0000000..4d87080
--- /dev/null
+++ b/src/harness-auth-recovery.test.ts
@@ -0,0 +1,98 @@
+// Harness r32: one same-account retry on 401, cache coherence after rotation, token-free telemetry.
+import assert from "node:assert/strict"
+import { mkdtempSync, readFileSync, writeFileSync, existsSync } from "node:fs"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { describe, it, before } from "node:test"
+
+const home = mkdtempSync(join(tmpdir(), "auth-r32-"))
+process.env.HOME = home
+process.env.HARNESS_STATE_DIR = join(home, "state")
+const configDir = join(home, "claude")
+const telemetry = join(home, "state", "telemetry", "token-saving.jsonl")
+const writeStore = (accessToken: string, refreshToken = "fake-refresh-1") =>
+  writeFileSync(join(configDir, ".credentials.json"), JSON.stringify({ claudeAiOauth: { accessToken, refreshToken, expiresAt: Date.now() + 3600_000 } }))
+const events = () => (existsSync(telemetry) ? readFileSync(telemetry, "utf8").trim().split("\n").map((l) => JSON.parse(l)) : [])
+
+const { mkdirSync } = await import("node:fs")
+mkdirSync(configDir, { recursive: true })
+writeStore("fake-old-access")
+const credentials = await import("./credentials.ts")
+const provider = await import("./provider.ts")
+
+const account = () => ({ label: "A", source: "file", configDir, credentials: { accessToken: "fake-old-access", refreshToken: "fake-refresh-1", expiresAt: Date.now() + 3600_000 } })
+const prepared = async () =>
+  provider.prepareClaudeRequest(
+    new Request("https://api.anthropic.com/v1/messages", { method: "POST", body: JSON.stringify({ model: "claude-sonnet-4-6", messages: [] }) }),
+    "fake-opencode-access",
+    "file",
+  )
+
+describe("harness r32 auth recovery", () => {
+  before(() => { credentials.initAccounts([account()]); credentials.setActiveAccountSource("file") })
+
+  it("a 401 is retried once with the same account's newer stored token", async () => {
+    const request = await prepared()
+    assert.equal(request.headers.get("authorization"), "Bearer fake-old-access")
+    writeStore("fake-new-access", "fake-refresh-2") // another process rotated it
+    const sent: string[] = []
+    const result = await provider.finishClaudeResponse(request, new Response("revoked", { status: 401 }), "file", async (_url, init) => {
+      sent.push(new Headers(init?.headers).get("authorization") ?? "")
+      assert.equal(typeof init?.body, "string")
+      return new Response("ok", { status: 200 })
+    })
+    assert.equal(result.status, 200)
+    assert.deepEqual(sent, ["Bearer fake-new-access"])
+    const last = events().at(-1)
+    assert.equal(last.event, "claude_auth_recovery"); assert.equal(last.outcome, "retried"); assert.equal(last.how, "reloaded")
+    assert.equal(last.retryStatus, 200); assert.equal(last.model, "claude-sonnet-4-6")
+    assert.doesNotMatch(readFileSync(telemetry, "utf8"), /fake-/, "no token values in telemetry")
+  })
+
+  it("never retries twice: a second 401 is returned as is", async () => {
+    const request = await prepared() // signed with fake-new-access (now cached)
+    writeStore("fake-newer-access", "fake-refresh-3")
+    let calls = 0
+    const result = await provider.finishClaudeResponse(request, new Response("revoked", { status: 401 }), "file", async () => { calls++; return new Response("still", { status: 401 }) })
+    assert.equal(calls, 1); assert.equal(result.status, 401)
+    assert.equal(events().at(-1).outcome, "retry_failed")
+  })
+
+  it("no newer token and a failing refresh: no retry, initial response returned", async () => {
+    const request = await prepared()
+    const token = request.headers.get("authorization")!.slice(7)
+    writeStore(token, "fake-refresh-dead")
+    const realFetch = globalThis.fetch
+    globalThis.fetch = (async () => new Response(JSON.stringify({ error: "invalid_grant" }), { status: 400 })) as typeof fetch
+    try {
+      let calls = 0
+      const initial = new Response("revoked", { status: 401 })
+      const result = await provider.finishClaudeResponse(request, initial, "file", async () => { calls++; return new Response("x") })
+      assert.equal(calls, 0); assert.equal(result, initial)
+      assert.equal(events().at(-1).outcome, "no_new_token")
+    } finally { globalThis.fetch = realFetch }
+  })
+
+  it("400/429/529 are still never retried", async () => {
+    for (const status of [400, 429, 529]) {
+      let calls = 0
+      const initial = new Response("denied", { status })
+      const result = await provider.finishClaudeResponse(await prepared(), initial, "file", async () => { calls++; return new Response("x") })
+      assert.equal(calls, 0); assert.equal(result, initial)
+    }
+  })
+
+  it("rotation through the OpenCode refresh path updates the request cache (root cause)", async () => {
+    writeStore("fake-before-rotation", "fake-refresh-9")
+    credentials.reloadCredentialsFromSource(credentials.getAccountBySource("file")!)
+    assert.equal((await credentials.getCachedCredentials(credentials.getAccountBySource("file")!))?.accessToken, "fake-before-rotation")
+    const realFetch = globalThis.fetch
+    globalThis.fetch = (async () => new Response(JSON.stringify({ access_token: "fake-rotated", refresh_token: "fake-refresh-10", expires_in: 3600 }), { status: 200 })) as typeof fetch
+    try {
+      const rotated = await credentials.rotateAccountCredentials(credentials.getAccountBySource("file")!)
+      assert.equal(rotated?.accessToken, "fake-rotated")
+    } finally { globalThis.fetch = realFetch }
+    const request = await prepared()
+    assert.equal(request.headers.get("authorization"), "Bearer fake-rotated", "next request is signed with the new token, not the revoked one")
+  })
+})

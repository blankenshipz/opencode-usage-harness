+/**
+ * Harness r32: a 401 (revoked or rotated access token) gets exactly one retry,
+ * for the SAME account only: re-read its own credential store, else one OAuth
+ * refresh of its own refresh token. No other account, no API key, no CLI, no
+ * retry for any other status, and never a second retry. The request was already
+ * admitted for this account; only its bearer token changes. Records a
+ * `claude_auth_recovery` telemetry event without any token value.
+ */
+async function recoverUnauthorized(
+  request: Request,
+  source: string | undefined,
+  send: Fetch,
+): Promise<Response | null> {
+  const modelID = modelFromBody(preparedBodies.get(request) ?? "")
+  const report = (outcome: string, extra: Record<string, unknown> = {}) =>
+    recordHarnessAuthEvent({ event: "claude_auth_recovery", outcome, status: 401, model: modelID, ...extra })
+  try {
+    if (request.signal?.aborted) return report("aborted"), null
+    const account = resolveAccount(source)
+    if (!account) return report("no_account"), null
+    const rejected = request.headers.get("authorization")?.replace(/^Bearer /i, "") ?? ""
+    let pending = recoveries.get(account.source)
+    if (!pending) {
+      pending = (async () => {
+        const reloaded = reloadCredentialsFromSource(account)
+        if (reloaded && reloaded.accessToken !== rejected) return { token: reloaded, how: "reloaded" }
+        const current = await getCachedCredentials(account)
+        if (current && current.accessToken !== rejected) return { token: current, how: "cached" }
+        return { token: await forceRefreshActiveAccount(undefined, account), how: "refreshed" }
+      })().finally(() => recoveries.delete(account.source))
+      recoveries.set(account.source, pending)
+    }
+    const { token, how } = await pending
+    if (!token || !token.accessToken || token.accessToken === rejected) return report("no_new_token", { how }), null
+    const body = preparedBodies.get(request) ?? (await request.clone().text())
+    const headers = new Headers(request.headers)
+    headers.set("authorization", `Bearer ${token.accessToken}`)
+    headers.set("x-client-request-id", crypto.randomUUID())
+    log("auth_recovery_retry", { modelID, how })
+    const response = await send(request.url, { method: request.method, headers, body, signal: request.signal })
+    report(response.ok ? "retried" : "retry_failed", { how, retryStatus: response.status })
+    return response
+  } catch (cause) {
+    report("error", { error: String((cause as Error)?.name ?? "Error").slice(0, 40) })
+    return null
+  } finally {
+    preparedBodies.delete(request)
+  }
+}

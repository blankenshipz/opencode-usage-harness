#!/usr/bin/env bash
# Refuse pushes to main/master unless the pushed tree has a passing review verdict
# in review-verdicts.jsonl, or the tip commit message carries an "Unreviewed:" line.
set -u
# Same default as plugins/v2/paths.mjs, plus the live ocharness state dir.
if [ -n "${HARNESS_STATE_DIR:-}" ]; then verdict_files=("$HARNESS_STATE_DIR/review-verdicts.jsonl")
else verdict_files=("$HOME/.local/state/opencode-usage-harness/review-verdicts.jsonl" "$HOME/work/ocharness/state/review-verdicts.jsonl"); fi
verdicts="${verdict_files[*]}"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  case "$remote_ref" in refs/heads/main|refs/heads/master) ;; *) continue ;; esac
  case "$local_sha" in "$zero"|0000000*) continue ;; esac  # branch deletion
  tree=$(git rev-parse "${local_sha}^{tree}" 2>/dev/null) || { echo "pre-push: cannot resolve tree of $local_sha" >&2; status=1; continue; }
  if python3 -I - "$tree" "${verdict_files[@]}" <<'PY'
import json, sys
tree = sys.argv[1]
for name in sys.argv[2:]:
    try:
        fh = open(name, encoding="utf-8", errors="replace")
    except OSError:
        continue
    with fh:
        for line in fh:
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row, dict) and row.get("tree") == tree and row.get("verdict") == "pass":
                sys.exit(0)
sys.exit(1)
PY
  then continue; fi
  if git log -1 --format=%B "$local_sha" 2>/dev/null | grep -q '^Unreviewed:'; then
    echo "pre-push: pushing unreviewed tree $tree to $remote_ref (Unreviewed: trailer present)" >&2
    continue
  fi
  echo "pre-push: REFUSED push to $remote_ref: tree $tree of $local_sha has no passing review verdict in $verdicts." >&2
  echo "pre-push: get a passing reviewer/verifier verdict for this exact tree, or add an 'Unreviewed: <reason>' line to the tip commit message." >&2
  status=1
done
exit $status
